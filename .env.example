APP_NAME=HotelLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/hotellink/public
# URL del portal React: enlace de recuperacion de contrasena y origen autorizado por CORS.
FRONTEND_URL=http://localhost:5173
# Solo si hay mas de un origen autorizado (separados por comas). Por defecto: FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=https://reservas.tudominio.com,https://www.tudominio.com

# Sesiones de la API, en minutos: inactividad normal, inactividad con "Recordarme" (30 dias)
# y tope absoluto de cualquier token (90 dias).
SANCTUM_INACTIVIDAD=120
SANCTUM_INACTIVIDAD_RECORDAR=43200
SANCTUM_EXPIRATION=129600

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotellink
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database #Se coloca (file) para no guardar las sessiones en db
SESSION_LIFETIME=43200
SESSION_EXPIRE_ON_CLOSE=true #La sesion termina al cerrar el navegador; es lo que hace util la casilla "Recordarme"

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP real. Pon las credenciales reales en tu .env (NUNCA aqui en el .example).
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="reservas@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WS_API_URL=

# ===== Datos del hotel (config/hotel.php). Si no se definen, se usan los de ese archivo =====
# HOTEL_NOMBRE=HotelLink
# HOTEL_TELEFONO="+503 2389-6000"
# HOTEL_WHATSAPP="+503 7000-0000"
# HOTEL_EMAIL=reservas@hotellink.com
# HOTEL_CHECKIN=14:00
# HOTEL_CHECKOUT=12:00

# ===== Docker (solo afecta a los contenedores; Herd/XAMPP siguen igual) =====
# Puertos que se publican en tu maquina. Cambialos si ya los usas.
APP_PORT=8080          # http://localhost:8080  -> back  (hotellink-back,  Laravel web01)
WEB02_PORT=8081        # http://localhost:8081  -> web02 (hotellink-web02, Laravel web02)
VITE_PORT=5173         # http://localhost:5173  -> front (portal React, dev)
# La base de datos NO publica puerto: solo es alcanzable dentro de la red hotellink-net.
# Para consultarla:  docker compose exec base mariadb -uhotellink -p hotellink

# Credenciales de la BD dentro de los contenedores (usuario de aplicacion, no root).
DOCKER_DB_USER=hotellink
DOCKER_DB_PASSWORD=hotellink_dev
# Contrasena root de MariaDB dentro del contenedor. En produccion ponla FUERTE.
DB_ROOT_PASSWORD=root_dev
